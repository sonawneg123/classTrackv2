# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── MySQL ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=classtrack_ai
DB_POOL_LIMIT=10

# ── Auth (legacy — still used by /api/auth/* and as the fallback expiry) ────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Auth (enterprise IAM — /api/v1/auth/*) ──────────────────────────────────
# Short-lived access token; the client refreshes it using the refresh token.
JWT_ACCESS_EXPIRES_IN=15m
# Long-lived, rotating refresh token.
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_TOKEN_BYTES=64

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Email verification — OFF by default so existing/seeded accounts (created
# before this module existed) are never locked out of login. Turn on once
# SMTP is configured and tested in production.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Forgot / reset password
PASSWORD_RESET_EXPIRES_MINUTES=60

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST unset to use the dev "console transport" (logs the email
# instead of sending it) — no real mail provider needed for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@classtrack.ai
EMAIL_FROM_NAME=ClassTrack AI

# ── Groq AI ──────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Verify current vision model at https://console.groq.com/docs/vision
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15
UPLOAD_DIR=uploads

# ── AI Queue ─────────────────────────────────────────────────────────────────
AI_QUEUE_CONCURRENCY=3

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug
LOG_DIR=logs
